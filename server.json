{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.defrr/defrr",
  "description": "RevRec schedules, renewals, credits, usage pricing, multi-currency, back-dated. Saves drafts.",
  "title": "defrr",
  "repository": {
    "url": "https://github.com/defrr-com/defrr-mcp",
    "source": "github"
  },
  "version": "1.4.1",
  "websiteUrl": "https://defrr.com/developers",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/defrr-com/defrr-mcp/main/assets/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "967x908"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://defrr.com/v1/mcp",
      "headers": [
        {
          "description": "Your defrr API key as a bearer token: Bearer dfr_live_...",
          "isRequired": true,
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ]
}
